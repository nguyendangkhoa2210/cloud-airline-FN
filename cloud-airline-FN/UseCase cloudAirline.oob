<o:UseCase Id="o114">
<a:ObjectID>64F23E3B-D104-402D-B2E8-3FFC2F914917</a:ObjectID>
<a:Name>Đổi vé</a:Name>
<a:Code>Đoi_ve</a:Code>
<a:CreationDate>1782526599</a:CreationDate>
<a:Creator>khoa</a:Creator>
<a:ModificationDate>1785683655</a:ModificationDate>
<a:Modifier>khoa</a:Modifier>
<a:Step>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset163 Times New Roman;}{\f1\froman\fprq2\fcharset0 Times New Roman;}{\f2\fswiss\fcharset238 Arial;}{\f3\froman\fprq2\fcharset238 Times New Roman CE;}{\f4\froman\fprq2\fcharset238 Times New Roman;}{\f5\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\widctlpar\f0\fs20\lang1066 1. H\u7897?i vi\&#39;ean ch\u7885?n &quot;\&#39;d0\u7893?i v\&#39;e9&quot; tr\&#39;ean 1 v\&#39;e9 c\u7911?a m\f1\lang1033\&#39;ecnh.\par
\f0\lang1066 2. H\u7879? th\u7889?ng hi\u7875?n th\u7883? danh s\&#39;e1ch chuy\u7871?n bay kh\&#39;e1c c\&#39;f9ng tuy\u7871?n, \u7849?n/kho\&#39;e1 chuy\u7871?n \&#39;f0\f1\lang1033\&#39;e3 h\f0\lang1066\u7871?t ch\u7895? theo \f2\lang1033\&#39;f0\f1\&#39;fang h\f0\lang1066\u7841?\f3\lang1033 ng v\&#39;e9.\f1\par
3. H\f0\lang1066\u7897?i vi\&#39;ean ch\u7885?n chuy\u7871?n bay m\u7899?i v\&#39;e0 ng\&#39;e0y bay m\u7899?i.\par
4. H\u7879? th\u7889?ng ki\u7875?m tra gh\u7871? c\f4\u361? c\&#39;f3 b\f0\u7883? tr\&#39;f9ng v\u7899?i h\&#39;e0nh kh\&#39;e1ch kh\&#39;e1c tr\&#39;ean chuy\u7871?n M\u7898?I hay kh\&#39;f4ng.\par
\f3\lang1033 5. H\f0\lang1066\u7879?\f3\lang1033  th\f0\lang1066\u7889?\f3\lang1033 ng t\&#39;ednh l\f0\lang1066\u7841?\f3\lang1033 i t\f0\lang1066\u7893?\f3\lang1033 ng ti\f0\lang1066\u7873?\f3\lang1033 n: gi\&#39;e1 v\&#39;e9 m\f0\lang1066\u7899?\f3\lang1033 i + ph\f0\lang1066\u7909?\f3\lang1033  thu gh\f0\lang1066\u7871?\f3\lang1033 /ti\f0\lang1066\u7879?\f3\lang1033 n \&#39;edch c\f2\u361?\f3  + ph\&#39;ed \&#39;f0\f0\lang1066\u7893?\f3\lang1033 i v\&#39;e9 (n\f0\lang1066\u7871?\f3\lang1033 u Eco).\f1\par

\pard 6. H\f0\lang1066\u7879? th\u7889?ng c\u7853?p nh\u7853?t booking: chuy\u7871?n bay m\u7899?i, ng\&#39;e0y m\u7899?i, t\u7893?ng ti\u7873?n m\u7899?i.\f5\lang1033\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\f0\fs20 kh\&#39;f4ng c\&#39;f3\par
}
</a:UseCase.Extension>
<a:Throws>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset0 Times New Roman;}{\f1\froman\fprq2\fcharset163 Times New Roman;}{\f2\fnil\fcharset1 Cambria Math;}{\f3\froman\fprq2\fcharset238 Times New Roman CE;}{\f4\fswiss\fcharset238 Arial;}{\f5\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}{\*\mmathPr\mmathFont2\mwrapIndent1440 }\viewkind4\uc1 
\pard\widctlpar\f0\fs20 H\f1\lang1066\u7841?ng v\&#39;e9 Promo \f2\u8594?\f1\lang1066  t\u7915? ch\u7889?i ho\&#39;e0n to\&#39;e0n\par
\f3\lang1033 Chuy\f1\lang1066\u7871?\f3\lang1033 n bay m\f1\lang1066\u7899?\f3\lang1033 i kh\&#39;e1c tuy\f1\lang1066\u7871?\f3\lang1033 n (kh\&#39;e1c \&#39;f0i\f1\lang1066\u7875?\f3\lang1033 m \&#39;f0i/\&#39;f0\f1\lang1066\u7871?\f3\lang1033 n) so v\f1\lang1066\u7899?\f3\lang1033 i chuy\f1\lang1066\u7871?\f3\lang1033 n c\f4\u361?\f3  \f2\u8594?\f3\lang1033  t\f1\lang1066\u7915?\f3\lang1033  ch\f1\lang1066\u7889?\f3\lang1033 i.\f0\par
\f3 Chuy\f1\lang1066\u7871?\f3\lang1033 n bay m\f1\lang1066\u7899?\f3\lang1033 i kh\&#39;f4ng t\f1\lang1066\u7891?\f3\lang1033 n t\f1\lang1066\u7841?\f3\lang1033 i ho\f1\lang1066\u7863?\f3\lang1033 c \&#39;f0\f0\&#39;e3 b\f1\lang1066\u7883? h\u7911?y \f2\u8594?\f1\lang1066  t\u7915? ch\u7889?i.\par
\f3\lang1033 Gh\f1\lang1066\u7871?\f3\lang1033  c\f4\u361?\f3  \&#39;f0\f0\&#39;e3 c\&#39;f3 h\&#39;e0nh kh\&#39;e1ch kh\&#39;e1c \f1\lang1066\&#39;f0\u7863?t tr\&#39;ean chuy\u7871?n bay M\u7898?I \f2\u8594?\f1\lang1066  t\u7915? ch\u7889?i, y\&#39;eau c\u7847?u li\&#39;ean h\u7879? h\u7895? tr\u7907?\f0\lang1033\par

\pard Kh\&#39;f4ng ph\f1\lang1066\u7843?i ch\u7911? v\&#39;e9/kh\&#39;f4ng ph\u7843?i Admin \f2\u8594?\f1\lang1066  t\u7915? ch\u7889?i \f5\lang1033\par
}
</a:Throws>
<a:PreCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset163 Times New Roman;}{\f1\froman\fprq2\fcharset0 Times New Roman;}{\f2\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\widctlpar\f0\fs20\lang1066 H\u7897?i vi\&#39;ean \&#39;f0\f1\lang1033\&#39;e3 \f0\lang1066\&#39;f0\&#39;e3ng nh\u7853?p (&lt;&lt;include&gt;&gt; &quot;\&#39;d0\&#39;e3ng nh\u7853?p&quot;), l\&#39;e0 ch\u7911? v\&#39;e9, v\&#39;e9 \&#39;f0ang \u7903? tr\u7841?ng th\&#39;e1i Confirmed.\f1\lang1033\par

\pard\f0\lang1066 H\u7841?ng v\&#39;e9 ph\u7843?i l\&#39;e0 Eco ho\u7863?c SkyBoss (h\u7841?ng Promo kh\&#39;f4ng \&#39;f0\&#39;fd\u7907?c \&#39;f0\u7893?i).\f2\lang1033\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset163 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\f0\fs20\lang1066 Booking \&#39;f0\&#39;fd\u7907?c c\u7853?p nh\u7853?t sang chuy\u7871?n bay/ng\&#39;e0y m\u7899?i; ph\&#39;ed \&#39;f0\u7893?i v\&#39;e9 $50 \&#39;f0\&#39;fd\u7907?c c\u7897?ng v\&#39;e0o t\u7893?ng ti\u7873?n n\u7871?u h\u7841?ng Eco, mi\u7877?n ph\&#39;ed n\u7871?u SkyBoss.\f1\lang1033\par
}
</a:PostCondition>
</o:UseCase>
