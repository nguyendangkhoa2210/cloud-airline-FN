<a:Throws>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset0 Times New Roman;}{\f1\froman\fprq2\fcharset163 Times New Roman;}{\f2\fnil\fcharset1 Cambria Math;}{\f3\froman\fprq2\fcharset238 Times New Roman CE;}{\f4\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}{\*\mmathPr\mmathFont2\mwrapIndent1440 }\viewkind4\uc1 
\pard\widctlpar\f0\fs20 Sai email ho\f1\lang1066\u7863?c m\u7853?t kh\u7849?u \f2\u8594?\f1\lang1066  th\&#39;f4ng b\&#39;e1o l\u7895?i chung, kh\&#39;f4ng ti\u7871?t l\u7897? email c\&#39;f3 t\u7891?n t\u7841?i hay kh\&#39;f4ng.\par
\f3\lang1033 Sai qu\&#39;e1 5 l\f1\lang1066\u7847?\f3\lang1033 n / 60 gi\&#39;e2y \f2\u8594?\f3\lang1033  kho\&#39;e1 \&#39;f0\&#39;e3ng nh\f1\lang1066\u7853?\f3\lang1033 p 5 ph\&#39;fat (HTTP 429), ti\f1\lang1066\u7871?\f3\lang1033 p t\f1\lang1066\u7909?\f3\lang1033 c \&#39;f0\f1\lang1066\u7871?\f3\lang1033 m n\f1\lang1066\u7871?\f3\lang1033 u v\f1\lang1066\u7851?\f3\lang1033 n sai trong l\&#39;fac b\f1\lang1066\u7883?\f3\lang1033  kho\&#39;e1.\f0\par

\pard\f1\lang1066 CSRF token h\u7871?t h\u7841?n (phi\&#39;ean t\u7891?n t\u7841?i l\&#39;e2u) \f2\u8594?\f1\lang1066  frontend t\u7921? l\u7845?y token m\u7899?i v\&#39;e0 g\u7917?i l\u7841?i request, ng\&#39;fd\u7901?i d\&#39;f9ng kh\&#39;f4ng th\u7845?y l\u7895?i.\f4\lang1033\par
}
</a:Throws>
<a:PreCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset238 Times New Roman CE;}{\f1\froman\fprq2\fcharset0 Times New Roman;}{\f2\froman\fprq2\fcharset163 Times New Roman;}{\f3\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\f0\fs20 Kh\&#39;e1ch \&#39;f0\f1\&#39;e3 c\&#39;f3 t\&#39;e0i kho\f2\lang1066\u7843?n \f3\lang1033\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset163 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\f0\fs20\lang1066 Session \&#39;f0\&#39;fd\u7907?c t\u7841?o tr\&#39;ean server (s\u7889?ng t\u7889?i \&#39;f0a 2 gi\u7901?), actor t\u7915? Kh\&#39;e1ch chuy\u7875?n th\&#39;e0nh H\u7897?i vi\&#39;ean trong ph\u7841?m vi phi\&#39;ean l\&#39;e0m vi\u7879?c n\&#39;e0y.\f1\lang1033\par
}
</a:PostCondition>
