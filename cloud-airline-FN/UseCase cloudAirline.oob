\pard\f0\lang1033 Qu\&#39;e1 5 l\f1\lang1066\u7847?n sai / 60 gi\&#39;e2y \f2\u8594?\f1\lang1066  kho\&#39;e1 5 ph\&#39;fat.\f3\lang1033\par
}
