\pard\widctlpar\f0\fs20\lang1066 1. Kh\&#39;e1ch ch\u7885?n \&#39;f0i\u7875?m kh\u7903?i h\&#39;e0nh, \&#39;f0i\u7875?m \&#39;f0\u7871?n, ng\&#39;e0y bay, h\u7841?ng v\&#39;e9 mong mu\u7889?n.\f1\lang1033\par
