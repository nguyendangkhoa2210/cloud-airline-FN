<c:UseCases>
<o:UseCase Id="o96">
<a:ObjectID>29BA0986-9EAB-4B60-969B-856328693967</a:ObjectID>
<a:Name>Đặt Vé</a:Name>
<a:Code>Đat_Ve</a:Code>
<a:CreationDate>1782526599</a:CreationDate>
<a:Creator>khoa</a:Creator>
<a:ModificationDate>1785683176</a:ModificationDate>
<a:Modifier>khoa</a:Modifier>
<a:Step>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset0 Times New Roman;}{\f1\froman\fprq2\fcharset163 Times New Roman;}{\f2\fswiss\fcharset238 Arial;}{\f3\froman\fprq2\fcharset238 Times New Roman CE;}{\f4\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\widctlpar\f0\fs20 1. &lt;&lt;include&gt;&gt; &quot;Ch\f1\lang1066\u7885?n gh\u7871? ng\u7891?i&quot;.\par
2. &lt;&lt;include&gt;&gt; &quot;Nh\u7853?p th\&#39;f4ng tin&quot; (th\&#39;f4ng tin t\u7915?ng h\&#39;e0nh kh\&#39;e1ch).\par
3. &lt;&lt;include&gt;&gt; &quot;Ch\u7885?n ti\u7879?n \&#39;edch&quot; (h\&#39;e0nh l\f0\lang1033\&#39;fd/su\f1\lang1066\u7845?t \f2\lang1033\&#39;e3\f0 n/b\f1\lang1066\u7843?\f3\lang1033 o hi\f1\lang1066\u7875?\f3\lang1033 m \emdash  kh\&#39;f4ng b\f1\lang1066\u7855?\f3\lang1033 t bu\f1\lang1066\u7897?\f3\lang1033 c).\f0\par
4. &lt;&lt;include&gt;&gt; &quot;X\&#39;e1c nh\f1\lang1066\u7853?n thanh to\&#39;e1n&quot;.\par
5. H\u7879? th\u7889?ng m\u7903? 1 transaction PDO duy nh\u7845?t.\par
6. H\u7879? th\u7889?ng t\u7921? t\&#39;ednh l\u7841?i 100% t\u7893?ng ti\u7873?n t\u7915? gi\&#39;e1 th\u7853?t trong DB (b\u7887? qua gi\&#39;e1 client g\u7917?i l\&#39;ean).\par
7. H\u7879? th\u7889?ng ki\u7875?m tra t\u7915?ng s\u7889? gh\u7871? c\u7909? th\u7875? ch\&#39;fda b\u7883? ng\&#39;fd\u7901?i kh\&#39;e1c \&#39;f0\u7863?t tr\&#39;f9ng.\f0\lang1033\par
8. H\f1\lang1066\u7879? th\u7889?ng insert booking + N h\&#39;e0nh kh\&#39;e1ch (booking_passengers) + N ti\u7879?n \&#39;edch (booking_addons).\par

\pard\f0\lang1033 9. Commit transaction, sinh m\&#39;e3 \f2\&#39;f0\f1\lang1066\u7863?\f3\lang1033 t ch\f1\lang1066\u7895?\f3\lang1033  d\f1\lang1066\u7841?\f3\lang1033 ng CH-xxxxxx, ghi log email x\&#39;e1c nh\f1\lang1066\u7853?\f3\lang1033 n (gi\f1\lang1066\u7843?\f3\lang1033  l\f1\lang1066\u7853?\f3\lang1033 p).\f4\par
}
</a:Step>
<a:UseCase.Extension>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset163 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\f0\fs20\lang1066 &lt;&lt;extend&gt;&gt; &quot;H\u7871?t h\u7841?n gi\u7919? ch\u7895?&quot; \emdash  k\&#39;edch ho\u7841?t khi qu\&#39;e1 30 ph\&#39;fat ch\&#39;fda ho\&#39;e0n t\u7845?t giao d\u7883?ch.\f1\lang1033\par
}
</a:UseCase.Extension>
<a:Throws>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset163 Times New Roman;}{\f1\froman\fprq2\fcharset0 Times New Roman;}{\f2\froman\fprq2\fcharset238 Times New Roman CE;}{\f3\fnil\fcharset1 Cambria Math;}{\f4\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}{\*\mmathPr\mmathFont3\mwrapIndent1440 }\viewkind4\uc1 
\pard\widctlpar\f0\fs20\lang1066 Gi\&#39;e1 v\&#39;e9/ph\u7909? thu gh\u7871?/gi\&#39;e1 ti\u7879?n \&#39;edch client g\u7917?i l\&#39;ean \&#39;f0\u7873?u b\u7883? b\u7887? qua, ch\u7881? tin d\u7919? li\u7879?u t\u7921? t\&#39;ednh t\u7915? DB.\f1\lang1033\par
\f2 Gh\f0\lang1066\u7871?\f2\lang1033  \&#39;f0\f1\&#39;e3 c\&#39;f3 ng\f0\lang1066\&#39;fd\u7901?i kh\&#39;e1c \&#39;f0\u7863?t (Confirmed) \f3\u8594?\f0\lang1066  t\u7915? ch\u7889?i, y\&#39;eau c\u7847?u ch\u7885?n l\u7841?i (HTTP 409).\f1\lang1033\par
\f0\lang1066 2 h\&#39;e0nh kh\&#39;e1ch \&#39;f0\&#39;fd\u7907?c g\&#39;e1n tr\&#39;f9ng 1 s\u7889? gh\u7871? trong c\&#39;f9ng 1 l\&#39;fd\u7907?t \&#39;f0\u7863?t \f3\u8594?\f0\lang1066  t\u7915? ch\u7889?i (HTTP 400).\f1\lang1033\par
\f2 Chuy\f0\lang1066\u7871?\f2\lang1033 n bay kh\&#39;f4ng t\f0\lang1066\u7891?\f2\lang1033 n t\f0\lang1066\u7841?\f2\lang1033 i ho\f0\lang1066\u7863?\f2\lang1033 c \&#39;f0\f1\&#39;e3 b\f0\lang1066\u7883? Admin hu\u7927? \f3\u8594?\f0\lang1066  t\u7915? ch\u7889?i.\par
Email h\&#39;e0nh kh\&#39;e1ch (n\u7871?u c\&#39;f3 nh\u7853?p) sai \&#39;f0\u7883?nh d\u7841?ng \f3\u8594?\f0\lang1066  t\u7915? ch\u7889?i.\f1\lang1033\par

\pard\f0\lang1066 L\u7895?i \u7903? B\u7844?T K\u7922? b\&#39;fd\u7899?c insert n\&#39;e0o \f3\u8594?\f0\lang1066  rollback to\&#39;e0n b\u7897? transaction, kh\&#39;f4ng t\u7841?o booking &quot;n\u7917?a v\u7901?i&quot;.\f4\lang1033\par
}
</a:Throws>
<a:PreCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset238 Times New Roman CE;}{\f1\froman\fprq2\fcharset0 Times New Roman;}{\f2\froman\fprq2\fcharset163 Times New Roman;}{\f3\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\widctlpar\f0\fs20 Kh\&#39;e1ch \&#39;f0\f1\&#39;e3 ch\f2\lang1066\u7885?n \&#39;f0\&#39;fd\u7907?c 1 chuy\u7871?n bay c\u7909? th\u7875? t\u7915? UC &quot;T\f1\lang1033\&#39;ecm ki\f2\lang1066\u7871?m chuy\u7871?n bay&quot;.\par

\pard\f0\lang1033 Kh\&#39;f4ng b\f2\lang1066\u7855?\f0\lang1033 t bu\f2\lang1066\u7897?\f0\lang1033 c \&#39;f0\&#39;e3ng nh\f2\lang1066\u7853?\f0\lang1033 p \emdash  kh\&#39;e1ch v\f1\&#39;e3ng lai v\f2\lang1066\u7851?n \&#39;f0\u7863?t \&#39;f0\&#39;fd\u7907?c (user_id = NULL trong booking).\f3\lang1033\par
}
</a:PreCondition>
<a:PostCondition>{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset163 Times New Roman;}{\f1\froman\fprq2\fcharset0 Times New Roman;}{\f2\fnil\fcharset0 Times New Roman;}}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\f0\fs20\lang1066 Booking m\u7899?i v\u7899?i status = &quot;Confirmed&quot; \&#39;f0\&#39;fd\u7907?c t\u7841?o, c\&#39;f3 m\f1\lang1033\&#39;e3 \f0\lang1066\&#39;f0\u7863?t ch\u7895? duy nh\u7845?t, hi\u7875?n th\u7883? m\&#39;e0n h\f1\lang1033\&#39;ecnh v\&#39;e9 \f0\lang1066\&#39;f0i\u7879?n t\u7917? th\&#39;e0nh c\&#39;f4ng.\f2\lang1033\par
}
</a:PostCondition>
</o:UseCase>
